# Decision backend: "laya" (local, default) or "typesafe" (hosted TypeSafe API).
JEV_BACKEND=laya

# Local Laya backend. Start the daemon first:
#   uv run --extra laya python scripts/layad.py
LAYA_URL=http://127.0.0.1:8420
# Or load the model in-process instead of using the daemon (requires the laya extra):
#LAYA_INPROCESS=1
#LAYA_MODEL=convaiinnovations/laya
#LAYA_DEVICE=mps
# Max candidates per target question; larger heads use a chunked tournament.
#LAYA_MAX_OPTIONS=10
#LAYA_TIMEOUT=10

# Hosted TypeSafe backend (only used when JEV_BACKEND=typesafe).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# For an Anthropic /v1/messages-only endpoint (e.g. an internal Anthropic proxy),
# switch the helper's wire shape instead:
#TEXT_MODEL_API_STYLE=anthropic
#TEXT_MODEL_MAX_TOKENS=2048
